<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="cloudflare-access-and-tunnel-architecture" name="Cloudflare Access and Tunnel Architecture">
    <mxGraphModel dx="1864" dy="1076" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="Homelab Cloudflare Access and Tunnel Architecture" vertex="1">
          <mxGeometry x="380" y="25" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" value="Primary private-DNS access · emulated Cloudflare access · outbound-only tunnel · direct Kubernetes administration" vertex="1">
          <mxGeometry x="410" y="70" width="980" height="25" as="geometry" />
        </mxCell>

        <mxCell id="ways-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontColor=#334155;fontSize=15;" value="Access methods — operator reminder" vertex="1">
          <mxGeometry x="30" y="115" width="1740" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cloudflare-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontColor=#1E3A8A;fontSize=15;" value="Cloudflare-managed trust boundary — configured remotely, not by this Git repository" vertex="1">
          <mxGeometry x="30" y="350" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="cluster-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;fontSize=15;" value="Homelab Kubernetes trust boundary — Git/Argo-managed unless marked otherwise" vertex="1">
          <mxGeometry x="800" y="350" width="970" height="360" as="geometry" />
        </mxCell>
        <mxCell id="memory-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontColor=#334155;fontSize=15;" value="Operational memory — names, ownership and first checks" vertex="1">
          <mxGeometry x="30" y="740" width="1740" height="270" as="geometry" />
        </mxCell>

        <mxCell id="external-human" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" value="&lt;b&gt;Emulated external human access&lt;/b&gt;&lt;br&gt;Cloudflare Access test path for selected hostnames&lt;br&gt;normal UI DNS resolves privately inside the homelab&lt;br&gt;application-native authentication may follow" vertex="1">
          <mxGeometry x="55" y="165" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="automation-access" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=14;" value="&lt;b&gt;CI / webhook access&lt;/b&gt;&lt;br&gt;ci-*.no-name.win · argocd-webhook.no-name.win&lt;br&gt;use a Cloudflare service token or narrowly scoped bypass&lt;br&gt;never reuse an interactive human policy implicitly" vertex="1">
          <mxGeometry x="480" y="165" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lan-access" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" value="&lt;b&gt;Primary homelab UI access&lt;/b&gt;&lt;br&gt;private DNS: &amp;lt;ui&amp;gt;.no-name.win → 192.168.122.120&lt;br&gt;browser connects directly to the Traefik Gateway&lt;br&gt;Cloudflare is bypassed by design; app authentication applies" vertex="1">
          <mxGeometry x="905" y="165" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="kube-admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;" value="&lt;b&gt;Kubernetes API administration&lt;/b&gt;&lt;br&gt;kubeconfig → kube-vip 192.168.122.30:6443&lt;br&gt;kubectl manages cluster resources through the API&lt;br&gt;independent of Cloudflare, cloudflared and Traefik" vertex="1">
          <mxGeometry x="1330" y="165" width="390" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cf-dns-edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;" value="&lt;b&gt;Cloudflare DNS + edge&lt;/b&gt;&lt;br&gt;published test-path resolution&lt;br&gt;edge TLS and request entry" vertex="1">
          <mxGeometry x="55" y="415" width="200" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cf-access" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=14;" value="&lt;b&gt;Cloudflare Access&lt;/b&gt;&lt;br&gt;application policy&lt;br&gt;IdP identity / group or service token&lt;br&gt;&lt;i&gt;only when attached to hostname&lt;/i&gt;" vertex="1">
          <mxGeometry x="290" y="405" width="200" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cf-tunnel-edge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=14;" value="&lt;b&gt;Cloudflare Tunnel edge&lt;/b&gt;&lt;br&gt;selects a healthy connector&lt;br&gt;for the remotely managed tunnel" vertex="1">
          <mxGeometry x="530" y="415" width="205" height="105" as="geometry" />
        </mxCell>
        <mxCell id="remote-config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" value="&lt;b&gt;Remote configuration that must be remembered&lt;/b&gt;&lt;br&gt;Cloudflare DNS records · Tunnel Public Hostnames → origin URL · Access applications and policies · IdP integration · service tokens / bypass rules&lt;br&gt;&lt;b&gt;An HTTPRoute in Git does not prove that its hostname is publicly published or Access-protected.&lt;/b&gt;" vertex="1">
          <mxGeometry x="55" y="570" width="680" height="105" as="geometry" />
        </mxCell>

        <mxCell id="cloudflared" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=14;strokeWidth=2;" value="&lt;b&gt;cloudflared Deployment&lt;/b&gt;&lt;br&gt;2 topology-spread replicas&lt;br&gt;outbound connector sessions only&lt;br&gt;token-authenticated · no Internet-facing listener" vertex="1">
          <mxGeometry x="830" y="405" width="210" height="125" as="geometry" />
        </mxCell>
        <mxCell id="origin-config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;" value="&lt;b&gt;Origin mapping&lt;/b&gt;&lt;br&gt;address + protocol + TLS behavior&lt;br&gt;defined in remote Tunnel config" vertex="1">
          <mxGeometry x="1070" y="420" width="165" height="95" as="geometry" />
        </mxCell>
        <mxCell id="traefik" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;strokeWidth=2;" value="&lt;b&gt;Traefik Gateway&lt;/b&gt;&lt;br&gt;LoadBalancer 192.168.122.120 :80/:443&lt;br&gt;HTTP redirects to HTTPS&lt;br&gt;websecure terminates *.no-name.win TLS" vertex="1">
          <mxGeometry x="1270" y="400" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="http-routes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=14;" value="&lt;b&gt;Gateway API HTTPRoutes&lt;/b&gt;&lt;br&gt;hostname + path matching&lt;br&gt;cross-namespace parentRefs&lt;br&gt;backend Service and port" vertex="1">
          <mxGeometry x="1530" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="services-pods" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;" value="&lt;b&gt;Application Services and Pods&lt;/b&gt;&lt;br&gt;native login/API authorization may still apply&lt;br&gt;Cilium policies govern workload traffic" vertex="1">
          <mxGeometry x="1530" y="570" width="210" height="105" as="geometry" />
        </mxCell>

        <mxCell id="vault-token" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=13;" value="&lt;b&gt;Vault KV&lt;/b&gt;&lt;br&gt;infra/cloudflare/tunnel" vertex="1">
          <mxGeometry x="830" y="585" width="130" height="75" as="geometry" />
        </mxCell>
        <mxCell id="vso-token" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=13;" value="&lt;b&gt;Vault Secrets Operator&lt;/b&gt;&lt;br&gt;refresh: 1 minute" vertex="1">
          <mxGeometry x="985" y="585" width="135" height="75" as="geometry" />
        </mxCell>
        <mxCell id="tunnel-secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=13;" value="&lt;b&gt;Kubernetes Secret&lt;/b&gt;&lt;br&gt;cloudflared-token&lt;br&gt;key: token" vertex="1">
          <mxGeometry x="1145" y="585" width="130" height="75" as="geometry" />
        </mxCell>
        <mxCell id="visibility" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=13;dashed=1;" value="&lt;b&gt;Visibility points&lt;/b&gt;&lt;br&gt;Cloudflare request/access logs&lt;br&gt;Traefik JSON access log&lt;br&gt;Cilium/Hubble flows · Falco runtime events" vertex="1">
          <mxGeometry x="1300" y="575" width="195" height="95" as="geometry" />
        </mxCell>

        <mxCell id="hostnames" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;" value="&lt;b&gt;Declared HTTPRoute hostname classes&lt;/b&gt; &lt;i&gt;(all end in .no-name.win)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Human/application:&lt;/b&gt; argocd · keycloak · sonarqube · dojo · kibana · grafana · prometheus · alertmanager · podinfo-lab-{a,b}-{dev,prod}&lt;br&gt;&lt;b&gt;Admin UI:&lt;/b&gt; longhorn · vault · traefik · hubble&lt;br&gt;&lt;b&gt;Machine endpoints:&lt;/b&gt; ci-argocd · ci-sonarqube · ci-dojo · ci-trivy · ci-zap · ci-podinfo-lab-a-dev · argocd-webhook&lt;br&gt;&lt;b&gt;Reminder:&lt;/b&gt; compare this Git inventory with Cloudflare Public Hostnames and Access applications; they are separate inventories." vertex="1">
          <mxGeometry x="55" y="790" width="820" height="175" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=13;" value="&lt;b&gt;Configuration ownership&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cloudflare Zero Trust:&lt;/b&gt; DNS, published hostnames/origins, Access policies, IdP and service tokens.&lt;br&gt;&lt;b&gt;Git + Argo CD:&lt;/b&gt; cloudflared workload, Traefik Gateway, wildcard Certificate, HTTPRoutes, Services and policies.&lt;br&gt;&lt;b&gt;Vault + VSO:&lt;/b&gt; tunnel token; cert-manager uses a separate Cloudflare DNS API token." vertex="1">
          <mxGeometry x="905" y="790" width="405" height="175" as="geometry" />
        </mxCell>
        <mxCell id="first-checks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" value="&lt;b&gt;First checks when access fails&lt;/b&gt;&lt;br&gt;&lt;b&gt;Primary UI path:&lt;/b&gt; private DNS → 192.168.122.120, then Traefik Gateway/HTTPRoute status.&lt;br&gt;&lt;b&gt;Cloudflare test path:&lt;/b&gt; Access policy, tunnel health, origin URL/TLS and cloudflared-token.&lt;br&gt;&lt;b&gt;Cluster administration:&lt;/b&gt; verify kube-vip 192.168.122.30:6443 and API health.&lt;br&gt;&lt;b&gt;Temporary app recovery:&lt;/b&gt; after API access works, use kubectl port-forward if needed." vertex="1">
          <mxGeometry x="1335" y="790" width="405" height="175" as="geometry" />
        </mxCell>

