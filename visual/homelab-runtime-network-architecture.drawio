          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-local-core" edge="1" parent="1" source="nodelocal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;fontSize=12;" target="coredns" value="cache miss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-core-cluster" edge="1" parent="1" source="coredns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;endArrow=block;endFill=1;fontSize=12;" target="cluster-records" value="cluster.local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-core-upstream" edge="1" parent="1" source="coredns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" target="upstream-dns" value="other zones">
          <mxGeometry relative="1" as="geometry">
