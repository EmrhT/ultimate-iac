          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-service-cilium" edge="1" parent="1" source="service-path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;fontSize=12;" target="cilium-forwarding">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cilium-policy" edge="1" parent="1" source="cilium-forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;" target="policy">
          <mxGeometry relative="1" as="geometry" />
