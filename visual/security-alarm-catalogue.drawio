<mxfile host="Electron" agent="Codex">
  <diagram id="security-alarm-catalogue" name="Security Alarm Catalogue">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Homelab Kubernetes Security Alarm Catalogue" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="360" y="18" width="1080" height="38" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Current PagerDuty triggers only — one card per alert rule, with its plain-language meaning" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="55" width="1120" height="24" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#B91C1C&quot;&gt;■&lt;/font&gt; Critical   &lt;font color=&quot;#D97706&quot;&gt;■&lt;/font&gt; Warning / High   &lt;font color=&quot;#2563EB&quot;&gt;■&lt;/font&gt; Audit/API   &lt;font color=&quot;#DC2626&quot;&gt;■&lt;/font&gt; Runtime   &lt;font color=&quot;#7C3AED&quot;&gt;■&lt;/font&gt; Admission   &lt;font color=&quot;#16A34A&quot;&gt;■&lt;/font&gt; Network" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="940" height="22" as="geometry" /></mxCell>

        <mxCell id="audit-group" value="Kubernetes Audit — API identity and authorization (5)" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F8FAFC;strokeColor=#2563EB;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="420" height="850" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Non-admin interactive Pod access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A non-admin identity opened exec, attach, port-forward, or ephemeral-container access. This is direct interactive access to a running workload, including access that may bypass the normal application interface.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;" vertex="1" parent="audit-group"><mxGeometry x="20" y="55" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Denied developer interactive Pod access&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kubernetes refused a developer's attempted exec, attach, port-forward, or debug session. The attempt did not succeed, but it records an access path that RBAC correctly blocked and may need context.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#172554;align=left;spacing=8;" vertex="1" parent="audit-group"><mxGeometry x="20" y="190" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Unapproved RBAC write&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;An identity outside the approved group successfully changed a Role, ClusterRole, or binding. Such a change can create or widen access to secrets, workloads, nodes, or the Kubernetes API itself.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;" vertex="1" parent="audit-group"><mxGeometry x="20" y="325" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;Denied unapproved RBAC write&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kubernetes refused an RBAC-change attempt by an unapproved identity. No privilege changed, but someone tried to alter the authorization model and the audit trail identifies who and what they targeted.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#172554;align=left;spacing=8;" vertex="1" parent="audit-group"><mxGeometry x="20" y="460" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;High-risk RBAC grant&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;An RBAC change grants wildcard, sensitive, bind/escalate, impersonate, or equivalent high-risk permissions. It catches privilege escalation even when the person making the change is otherwise an approved automation identity.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;" vertex="1" parent="audit-group"><mxGeometry x="20" y="595" width="380" height="125" as="geometry" /></mxCell>

        <mxCell id="falco-group" value="Falco — protected workload runtime behaviour (9)" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FFF7F7;strokeColor=#DC2626;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="620" height="850" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;Reverse Shell&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A process redirected stdin, stdout, and stderr through a network socket. This is the characteristic I/O pattern of an attacker obtaining an interactive remote shell.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="20" y="55" width="280" height="115" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;Web-Originated Process Execution&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A selected web application spawned a child process instead of only handling a request. For these self-contained services, it is strong evidence of command injection or a web shell.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="320" y="55" width="280" height="115" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;Unexpected Network Listener&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A protected workload opened a listening port outside its declared behavior. It can reveal a bind shell, a rogue proxy, or a process introduced after compromise.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="20" y="185" width="280" height="115" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;Payload Execution&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A process ran a binary or script from writable storage or anonymous memory. This catches common post-exploitation payload staging without relying on a particular tool name.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="320" y="185" width="280" height="115" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;Container Escape Behavior&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A workload attempted namespace, mount, root, kernel, or host manipulation associated with escape. The syscall-oriented rule also covers renamed or custom tools, not merely known escape binaries.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="20" y="315" width="280" height="125" as="geometry" /></mxCell>
        <mxCell id="f6" value="&lt;b&gt;Unexpected Root Process&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A selected non-root workload spawned a process running as UID 0. It indicates a successful in-container privilege escalation, apart from the expected runtime helper used for kubectl exec.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="320" y="315" width="280" height="125" as="geometry" /></mxCell>
        <mxCell id="f7" value="&lt;b&gt;Service Account Credential Access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A workload read a mounted Kubernetes service-account credential that should not exist there. In protected workloads, this points to credential injection, configuration regression, or attempted API access.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="20" y="455" width="280" height="125" as="geometry" /></mxCell>
        <mxCell id="f8" value="&lt;b&gt;Detect release_agent File Container Escapes&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A process accessed the cgroup-v1 release_agent interface. If it is writable and invoked, the kernel runs the configured program in the host context: a direct container-escape primitive.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="320" y="455" width="280" height="125" as="geometry" /></mxCell>
        <mxCell id="f9" value="&lt;b&gt;Fileless execution via memfd_create&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A process executed code from an anonymous in-memory file rather than a normal filesystem path. Malware uses this to avoid leaving a conventional executable on disk.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;" vertex="1" parent="falco-group"><mxGeometry x="20" y="595" width="280" height="115" as="geometry" /></mxCell>

        <mxCell id="kyverno-group" value="Kyverno — workload admission / configuration (6)" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FAF5FF;strokeColor=#7C3AED;fontStyle=1;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="660" height="850" as="geometry" /></mxCell>
        <mxCell id="k1" value="&lt;b&gt;Unsafe image source violation&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A Pod uses an unapproved image repository, the mutable latest tag, or no immutable digest. The deployed bytes cannot then be tied to the reviewed image chosen in Git.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="20" y="55" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="k2" value="&lt;b&gt;Explicit UID zero violation&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A workload explicitly configures a Pod or container to run as root (UID 0). Root is not automatically a host escape, but it removes a major containment layer after application compromise.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="340" y="55" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="k3" value="&lt;b&gt;Privileged container violation&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A container requests privileged mode outside an exact reviewed infrastructure exception. Privileged mode grants broad host-device and kernel access and sharply weakens container isolation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="20" y="190" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="k4" value="&lt;b&gt;Unapproved Linux capability addition&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A container adds a Linux capability outside NET_BIND_SERVICE or its exact approved set. Capabilities such as SYS_ADMIN, SYS_PTRACE, or NET_ADMIN can enable escalation or inspection beyond normal application needs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="340" y="190" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="k5" value="&lt;b&gt;Critical direct host access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A Pod uses host PID, host IPC, or an unapproved / writable hostPath mount. These expose host processes, host files, or runtime interfaces to a workload, so exceptions remain identity- and path-specific.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="20" y="335" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="k6" value="&lt;b&gt;Unapproved host network exposure&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;HIGH&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A Pod uses host networking or binds a host port outside its exact approved identity and port set. It bypasses normal Pod network separation or exposes a service directly from the node.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#4C1D95;align=left;spacing=8;" vertex="1" parent="kyverno-group"><mxGeometry x="340" y="335" width="300" height="125" as="geometry" /></mxCell>

        <mxCell id="cilium-group" value="Cilium / Hubble — network enforcement and telemetry coverage (2)" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="1740" height="95" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Cilium Policy Denied&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cilium dropped one or more connection attempts because a network policy denied the source-to-destination flow. The alert identifies the source namespace and destination workload so the policy decision can be reviewed.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;align=left;spacing=8;" vertex="1" parent="cilium-group"><mxGeometry x="20" y="40" width="820" height="50" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Hubble Metrics Missing on Ready Node&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A Kubernetes-ready node has no scrapeable Hubble metrics for three minutes. Workloads may still run, but policy-denial visibility for that node is incomplete until Hubble metrics recover.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;align=left;spacing=8;" vertex="1" parent="cilium-group"><mxGeometry x="860" y="40" width="860" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
