<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="security-alarm-catalogue" name="Security Alarm Catalogue">
    <mxGraphModel dx="1414" dy="787" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" value="Homelab Kubernetes Security Alarm Catalogue" vertex="1">
          <mxGeometry height="38" width="1080" x="360" y="18" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" value="Current PagerDuty triggers only — one card per alert rule, with its plain-language meaning" vertex="1">
          <mxGeometry height="24" width="1120" x="340" y="55" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#374151;" value="&lt;font color=&quot;#B91C1C&quot;&gt;■&lt;/font&gt; Critical &amp;nbsp; &lt;font color=&quot;#D97706&quot;&gt;■&lt;/font&gt; Warning / High &amp;nbsp; &lt;font color=&quot;#2563EB&quot;&gt;■&lt;/font&gt; Audit/API &amp;nbsp; &lt;font color=&quot;#DC2626&quot;&gt;■&lt;/font&gt; Runtime &amp;nbsp; &lt;font color=&quot;#7C3AED&quot;&gt;■&lt;/font&gt; Admission &amp;nbsp; &lt;font color=&quot;#16A34A&quot;&gt;■&lt;/font&gt; Network" vertex="1">
          <mxGeometry height="22" width="940" x="430" y="80" as="geometry" />
        </mxCell>
        <mxCell id="audit-group" parent="1" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F8FAFC;strokeColor=#2563EB;fontStyle=1;fontColor=#1E3A8A;fontSize=16;" value="Kubernetes Audit — API identity and authorization (5)" vertex="1">
          <mxGeometry height="850" width="420" x="30" y="120" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="audit-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Kubernetes non-admin interactive pod access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot; style=&quot;--darkreader-inline-color: var(--darkreader-text-b91c1c, #e55151);&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A non-admin identity opened exec, attach, port-forward, or ephemeral-container access. This is direct interactive access to a running workload, including access that may bypass the normal application interface.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="audit-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#172554;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Kubernetes denied developer interactive pod access&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font&gt;Kubernetes refused a developer&#39;s attempted exec, attach, port-forward, or debug session. The attempt did not succeed, but it records an access path that RBAC correctly blocked and may need context.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="20" y="190" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="audit-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Kubernetes unapproved RBAC write&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;An identity outside the approved group successfully changed a Role, ClusterRole, or binding. Such a change can create or widen access to secrets, workloads, nodes, or the Kubernetes API itself.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="20" y="325" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="audit-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#172554;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Kubernetes denied unapproved RBAC write&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font&gt;Kubernetes refused an RBAC-change attempt by an unapproved identity. No privilege changed, but someone tried to alter the authorization model and the audit trail identifies who and what they targeted.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="380" x="20" y="460" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="audit-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Kubernetes high-risk RBAC grant&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;An RBAC change grants wildcard, sensitive, bind/escalate, impersonate, or equivalent high-risk permissions. It catches privilege escalation even when the person making the change is otherwise an approved automation identity.&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="380" x="20" y="595" as="geometry" />
        </mxCell>
        <mxCell id="falco-group" parent="1" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FFF7F7;strokeColor=#DC2626;fontStyle=1;fontColor=#7F1D1D;fontSize=16;" value="Falco — protected workload runtime behaviour (9)" vertex="1">
          <mxGeometry height="850" width="620" x="470" y="120" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Reverse Shell&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A process redirected stdin, stdout, and stderr through a network socket. This is the characteristic I/O pattern of an attacker obtaining an interactive remote shell.&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="280" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Web-Originated Process Execution&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A selected web application spawned a child process instead of only handling a request. For these self-contained services, it is strong evidence of command injection or a web shell.&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="280" x="320" y="55" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Unexpected Network Listener&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A protected workload opened a listening port outside its declared behavior. It can reveal a bind shell, a rogue proxy, or a process introduced after compromise.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="20" y="204" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Payload Execution&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A process ran a binary or script from writable storage or anonymous memory. This catches common post-exploitation payload staging without relying on a particular tool name.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="320" y="204" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Container Escape Behavior&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A workload attempted namespace, mount, root, kernel, or host manipulation associated with escape. The syscall-oriented rule also covers renamed or custom tools, not merely known escape binaries.&lt;/font&gt;" vertex="1">
          <mxGeometry height="138" width="280" x="20" y="342" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Unexpected Root Process&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A selected non-root workload spawned a process running as UID 0. It indicates a successful in-container privilege escalation, apart from the expected runtime helper used for kubectl exec.&lt;/font&gt;" vertex="1">
          <mxGeometry height="138" width="280" x="320" y="342" as="geometry" />
        </mxCell>
        <mxCell id="f7" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Service Account Credential Access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A workload read a mounted Kubernetes service-account credential that should not exist there. In protected workloads, this points to credential injection, configuration regression, or attempted API access.&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="280" x="20" y="496" as="geometry" />
        </mxCell>
        <mxCell id="f8" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Detect release_agent File Container Escapes&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A process accessed the cgroup-v1 release_agent interface. If it is writable and invoked, the kernel runs the configured program in the host context: a direct container-escape primitive.&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="280" x="320" y="496" as="geometry" />
        </mxCell>
        <mxCell id="f9" parent="falco-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;Fileless execution via memfd_create&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A process executed code from an anonymous in-memory file rather than a normal filesystem path. Malware uses this to avoid leaving a conventional executable on disk.&lt;/font&gt;" vertex="1">
          <mxGeometry height="129" width="280" x="20" y="652" as="geometry" />
        </mxCell>
        <mxCell id="kyverno-group" parent="1" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#FAF5FF;strokeColor=#7C3AED;fontStyle=1;fontColor=#4C1D95;fontSize=16;" value="Kyverno — workload admission / configuration (6)" vertex="1">
          <mxGeometry height="520" width="660" x="1110" y="120" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;require-safe-image-references&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A Pod uses an unapproved image repository, the mutable latest tag, or no immutable digest.&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;audit-pod-security-context&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A workload explicitly configures a Pod or container to run as root (UID 0). Root is not automatically a host escape, but it removes a major containment layer after application compromise.&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="340" y="55" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;audit-pod-security-context&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A container requests privileged mode outside an exact reviewed/approved infrastructure exception. Privileged mode grants broad host-device and kernel access and sharply weakens container isolation.&lt;/font&gt;" vertex="1">
          <mxGeometry height="152" width="300" x="20" y="190" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;audit-pod-security-context&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A container adds a Linux capability outside NET_BIND_SERVICE or its exact approved set. Capabilities such as SYS_ADMIN, SYS_PTRACE, or NET_ADMIN can enable escalation or inspection beyond normal application needs.&lt;/font&gt;" vertex="1">
          <mxGeometry height="152" width="300" x="340" y="190" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;audit-host-access&lt;/b&gt; &lt;font color=&quot;#B91C1C&quot;&gt;CRITICAL&lt;/font&gt;&lt;br&gt;&lt;font&gt;A Pod uses host PID, host IPC, or an unapproved/writable hostPath mount. These expose host processes, host files, or runtime interfaces to a workload, so exceptions remain identity and path-specific.&lt;/font&gt;" vertex="1">
          <mxGeometry height="129" width="300" x="20" y="361" as="geometry" />
        </mxCell>
        <mxCell id="k6" parent="kyverno-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#4C1D95;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;audit-host-access&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;HIGH&lt;/font&gt;&lt;br&gt;&lt;font&gt;A Pod uses host networking or binds a host port outside its exact approved identity and port set. It bypasses normal Pod network separation or exposes a service directly from the node.&lt;/font&gt;" vertex="1">
          <mxGeometry height="129" width="300" x="340" y="361" as="geometry" />
        </mxCell>
        <mxCell id="cilium-group" parent="1" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;fontSize=16;" value="Cilium / Hubble — network enforcement and telemetry coverage (2)" vertex="1">
          <mxGeometry height="317" width="660" x="1113" y="653" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="cilium-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;CiliumPolicyDenied&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font&gt;Cilium dropped one or more connection attempts because a network policy denied the source-to-destination flow. The alert identifies the source namespace and destination workload so the policy decision can be reviewed.&lt;/font&gt;" vertex="1">
          <mxGeometry height="84.5" width="637" x="11.5" y="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="cilium-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;align=left;spacing=8;fontSize=14;" value="&lt;b&gt;HubbleMetricsMissingOnReadyNode&lt;/b&gt; &lt;font color=&quot;#D97706&quot;&gt;WARNING&lt;/font&gt;&lt;br&gt;&lt;font&gt;A Kubernetes-ready node has no scrapeable Hubble metrics for three minutes. Workloads may still run, but policy-denial visibility for that node is incomplete until Hubble metrics recover.&lt;/font&gt;" vertex="1">
          <mxGeometry height="71" width="637" x="11.5" y="133" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
