        <mxCell id="e-issuer-dns" edge="1" parent="1" source="issuers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" target="dns01">
          <mxGeometry relative="1" as="geometry" />
