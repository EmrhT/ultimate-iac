        <mxCell id="vault-header" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#6B21A8;" value="1  Secret source of truth — Vault" vertex="1">
          <mxGeometry height="28" width="440" x="50" y="112" as="geometry" />
        </mxCell>
        <mxCell id="vault-server" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Vault server&#xa;vault/vault-0" vertex="1">
          <mxGeometry height="72" width="200" x="175" y="160" as="geometry" />
        </mxCell>
        <mxCell id="vault-mode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C4B5FD;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Runtime mode&lt;/b&gt;&#xa;• Standalone integrated Raft storage&#xa;• In-cluster HTTP :8200; never expose externally&#xa;• Longhorn RWO PVC: data-vault-0 (500 MiB)&#xa;• Manual initialization and unseal; no auto-unseal" vertex="1">
          <mxGeometry height="105" width="440" x="55" y="260" as="geometry" />
        </mxCell>
        <mxCell id="vault-keys" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;External trust material — never Git or cluster&lt;/b&gt;&#xa;Unseal keys and root token are operator-held. Matching unseal keys are required to restore a Raft snapshot." vertex="1">
          <mxGeometry height="78" width="440" x="55" y="385" as="geometry" />
        </mxCell>
        <mxCell id="vault-backup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Two recovery copies&lt;/b&gt;&#xa;Longhorn daily PVC snapshots: retain 2&#xa;Controller Raft snapshots: 14 days, SHA-256 checksum, owner-only permissions" vertex="1">
          <mxGeometry height="78" width="440" x="55" y="480" as="geometry" />
        </mxCell>
        <mxCell id="delivery-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;arcSize=8;" value="" vertex="1">
          <mxGeometry height="500" width="590" x="540" y="100" as="geometry" />
        </mxCell>
        <mxCell id="delivery-header" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1D4ED8;" value="2  Vault → Kubernetes delivery — VSO" vertex="1">
          <mxGeometry height="28" width="540" x="560" y="112" as="geometry" />
        </mxCell>
        <mxCell id="git-declares" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Git / Argo CD&lt;/b&gt;&#xa;declares references only:&#xa;VaultAuth + VaultStaticSecret" vertex="1">
          <mxGeometry height="78" width="160" x="565" y="160" as="geometry" />
        </mxCell>
        <mxCell id="vso" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Vault Secrets Operator&#xa;vault-secrets-operator" vertex="1">
          <mxGeometry height="78" width="170" x="755" y="160" as="geometry" />
        </mxCell>
        <mxCell id="vault-connection" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=12;align=center;verticalAlign=middle;" value="VaultConnection/default&#xa;http://vault.vault.svc:8200" vertex="1">
          <mxGeometry height="78" width="150" x="955" y="160" as="geometry" />
        </mxCell>
        <mxCell id="auth-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Per-namespace authentication&lt;/b&gt;&#xa;1. vault-auth ServiceAccount requests a JWT with audience &lt;b&gt;vault&lt;/b&gt;&#xa;2. VaultAuth logs in at auth/kubernetes&#xa;3. Vault role authorizes the KV paths&#xa;   • vso-dev — Podinfo dev&#xa;   • vso-admin — infrastructure, security tools, Podinfo prod" vertex="1">
          <mxGeometry height="105" width="540" x="565" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sync-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Materialization and rotation&lt;/b&gt;&#xa;VaultStaticSecret reads KV v2 → VSO creates/overwrites a namespace-local Kubernetes Secret.&#xa;All 19 live objects refresh every &lt;b&gt;1 minute&lt;/b&gt;; HMAC comparison avoids unnecessary writes.&#xa;Secret values never appear in Git, but they do exist in Kubernetes etcd and Pod memory/files." vertex="1">
          <mxGeometry height="82" width="540" x="565" y="380" as="geometry" />
        </mxCell>
        <mxCell id="restart-boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Reload boundary:&lt;/b&gt; VSO automatically restarts only Podinfo, cloudflared, and ZAP. Other environment-variable consumers may require a reviewed rollout after rotation; mounted-secret consumers may reload themselves." vertex="1">
          <mxGeometry height="64" width="540" x="565" y="477" as="geometry" />
        </mxCell>
        <mxCell id="cert-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;arcSize=8;" value="" vertex="1">
          <mxGeometry height="500" width="620" x="1150" y="100" as="geometry" />
        </mxCell>
        <mxCell id="cert-header" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#047857;" value="3  Public certificate — automated DNS-01 lifecycle" vertex="1">
          <mxGeometry height="28" width="570" x="1170" y="112" as="geometry" />
        </mxCell>
        <mxCell id="cf-token" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;fontSize=12;align=center;verticalAlign=middle;" value="Vault KV&#xa;&lt;b&gt;infra/cert-manager/cloudflare&lt;/b&gt;&#xa;→ cloudflare-api-token-secret" vertex="1">
          <mxGeometry height="78" width="180" x="1175" y="160" as="geometry" />
        </mxCell>
        <mxCell id="issuers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=center;verticalAlign=middle;" value="cert-manager ClusterIssuers&#xa;&lt;b&gt;letsencrypt-staging&lt;/b&gt;&#xa;&lt;b&gt;letsencrypt-production&lt;/b&gt;" vertex="1">
          <mxGeometry height="78" width="175" x="1380" y="160" as="geometry" />
        </mxCell>
        <mxCell id="dns01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;fontSize=12;align=center;verticalAlign=middle;" value="ACME DNS-01&#xa;temporary TXT record in&#xa;&lt;b&gt;Cloudflare / no-name.win&lt;/b&gt;" vertex="1">
          <mxGeometry height="78" width="165" x="1580" y="160" as="geometry" />
        </mxCell>
        <mxCell id="le" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;fontSize=12;align=center;verticalAlign=middle;" value="Let&#39;s Encrypt validates DNS ownership and signs the certificate" vertex="1">
          <mxGeometry height="72" width="165" x="1580" y="275" as="geometry" />
        </mxCell>
        <mxCell id="certificate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" value="Certificate/traefik&#xa;&lt;b&gt;no-name-win-wildcard&lt;/b&gt;&#xa;no-name.win + *.no-name.win" vertex="1">
          <mxGeometry height="72" width="175" x="1380" y="275" as="geometry" />
        </mxCell>
        <mxCell id="tls-secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;fontSize=12;align=center;verticalAlign=middle;" value="Kubernetes TLS Secret&#xa;&lt;b&gt;no-name-win-wildcard-tls&lt;/b&gt;&#xa;private key + certificate chain" vertex="1">
          <mxGeometry height="72" width="180" x="1175" y="275" as="geometry" />
        </mxCell>
        <mxCell id="traefik" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;fontSize=12;align=center;verticalAlign=middle;" value="Traefik Gateway&#xa;certificateRefs → TLS Secret&#xa;terminates HTTPS for routes" vertex="1">
          <mxGeometry height="75" width="180" x="1175" y="385" as="geometry" />
        </mxCell>
        <mxCell id="cert-status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Current checked state — 1 Oct 2026&lt;/b&gt;&#xa;Ready=True · production issuer Ready&#xa;Valid: 11 Aug → 9 Nov 2026 · renewal scheduled: 10 Oct 2026&#xa;cert-manager renews before expiry and updates the same TLS Secret." vertex="1">
          <mxGeometry height="92" width="365" x="1380" y="385" as="geometry" />
        </mxCell>
        <mxCell id="other-certs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Separate internal certificate owners&lt;/b&gt;&#xa;• metrics-server: cert-manager Certificate + internal issuer&#xa;• Elasticsearch: ECK-generated HTTP CA/certificate Secret&#xa;These do not use the public wildcard or Vault PKI." vertex="1">
          <mxGeometry height="82" width="570" x="1175" y="500" as="geometry" />
        </mxCell>
        <mxCell id="inventory-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;arcSize=8;" value="" vertex="1">
          <mxGeometry height="425" width="1100" x="30" y="625" as="geometry" />
        </mxCell>
        <mxCell id="inventory-header" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#334155;" value="4  Live Vault KV inventory — path → derived Secret → consumer" vertex="1">
          <mxGeometry height="28" width="1040" x="50" y="637" as="geometry" />
        </mxCell>
        <mxCell id="inventory-table-head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" value="Vault KV v2 path" vertex="1">
          <mxGeometry height="30" width="275" x="55" y="680" as="geometry" />
        </mxCell>
        <mxCell id="inventory-table-head2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" value="Kubernetes destination / consumer" vertex="1">
          <mxGeometry height="30" width="560" x="330" y="680" as="geometry" />
        </mxCell>
        <mxCell id="inventory-table-head3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="Auto restart" vertex="1">
          <mxGeometry height="30" width="215" x="890" y="680" as="geometry" />
        </mxCell>
        <mxCell id="inv-paths" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="dev/podinfo · prod/podinfo&#xa;&#xa;infra/cloudflare/tunnel&#xa;infra/cert-manager/cloudflare&#xa;infra/keycloak/credentials&#xa;infra/monitoring/grafana&#xa;infra/monitoring/pagerduty&#xa;security/defectdojo/credentials&#xa;&#xa;security/sonarqube/credentials&#xa;security/zap/credentials" vertex="1">
          <mxGeometry height="260" width="275" x="55" y="710" as="geometry" />
        </mxCell>
        <mxCell id="inv-consumers" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="podinfo-vault in four lab namespaces → Podinfo&#xa;&#xa;cloudflared-token → cloudflared tunnel connector&#xa;cloudflare-api-token-secret → cert-manager DNS-01 solver&#xa;keycloak-credentials → Keycloak + its PostgreSQL&#xa;grafana-admin-credentials → Grafana&#xa;PagerDuty key → Alertmanager + ElastAlert2 destination Secret&#xa;Namespace-specific Secrets → DefectDojo and Falco/Kyverno/Nuclei/kube-bench exporters&#xa;security-sonarqube-credentials → SonarQube + scanner&#xa;security-zap-api-key → ZAP" vertex="1">
          <mxGeometry height="260" width="560" x="330" y="710" as="geometry" />
        </mxCell>
        <mxCell id="inv-restarts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;align=center;verticalAlign=top;spacing=8;" value="&lt;b&gt;Yes&lt;/b&gt; — Podinfo&#xa;&#xa;&lt;b&gt;Yes&lt;/b&gt; — cloudflared&#xa;No workload restart needed&#xa;No VSO restart hook&#xa;No VSO restart hook&#xa;No VSO restart hook&#xa;No VSO restart hook&#xa;&#xa;No VSO restart hook&#xa;&lt;b&gt;Yes&lt;/b&gt; — ZAP" vertex="1">
          <mxGeometry height="260" width="215" x="890" y="710" as="geometry" />
        </mxCell>
        <mxCell id="inventory-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;fontSize=12;align=left;verticalAlign=middle;spacing=8;" value="The repeated security/defectdojo path intentionally becomes different destination Secrets in each consumer namespace. This preserves namespace isolation while keeping one credential source." vertex="1">
          <mxGeometry height="42" width="1050" x="55" y="988" as="geometry" />
        </mxCell>
        <mxCell id="ops-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=2;arcSize=8;" value="" vertex="1">
          <mxGeometry height="425" width="620" x="1150" y="625" as="geometry" />
        </mxCell>
        <mxCell id="ops-header" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#B45309;" value="5  Rotation, failure, and recovery memory" vertex="1">
          <mxGeometry height="28" width="570" x="1170" y="637" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBBF24;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Ownership boundaries&lt;/b&gt;&#xa;• Git owns CRs, paths, destination names and restart declarations.&#xa;• Vault owns source values and access policy.&#xa;• VSO owns derived Kubernetes Secrets.&#xa;• cert-manager owns ACME account keys, CertificateRequests and TLS Secret renewal.&#xa;• ECK owns Elasticsearch credentials and its HTTP CA/certificates." vertex="1">
          <mxGeometry height="125" width="570" x="1175" y="680" as="geometry" />
        </mxCell>
        <mxCell id="failure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBBF24;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;If Vault is sealed or unavailable&lt;/b&gt;&#xa;Existing Kubernetes Secrets and running Pods continue to work. New synchronization and rotations stop; deleted derived Secrets cannot be recreated until Vault is healthy." vertex="1">
          <mxGeometry height="72" width="570" x="1175" y="825" as="geometry" />
        </mxCell>
        <mxCell id="recovery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Recovery order&lt;/b&gt;&#xa;1. Restore Vault-compatible Raft snapshot and unseal Vault.&#xa;2. Verify VaultConnection → VaultAuth → VaultStaticSecret Healthy/Ready.&#xa;3. Confirm derived Secrets, then roll consumers lacking a restart hook if values changed.&#xa;4. Verify ClusterIssuers and Certificate Ready before depending on public HTTPS." vertex="1">
          <mxGeometry height="110" width="570" x="1175" y="917" as="geometry" />
        </mxCell>
        <mxCell id="e-git-vso" edge="1" parent="1" source="git-declares" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" target="vso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-vso-conn" edge="1" parent="1" source="vso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" target="vault-connection">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-conn-vault" edge="1" parent="1" source="vault-connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;" target="vault-server">
          <mxGeometry relative="1" as="geometry">
