<mxfile host="Electron" agent="Codex">
  <diagram id="secrets-and-certificate-lifecycle" name="Secrets and Certificate Lifecycle">
    <mxGraphModel dx="1139" dy="662" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
