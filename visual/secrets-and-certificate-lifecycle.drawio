        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="Homelab Secrets and Certificate Lifecycle" vertex="1">
          <mxGeometry height="40" width="815" x="590" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" value="Where secret values live, how workloads receive them, how the public wildcard certificate renews, and what must be recovered first" vertex="1">
          <mxGeometry height="24" width="740" x="615" y="60" as="geometry" />
        </mxCell>
        <mxCell id="vault-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;arcSize=8;" value="" vertex="1">
          <mxGeometry height="500" width="490" x="30" y="100" as="geometry" />
