        <mxCell id="e-secret-traefik" edge="1" parent="1" source="tls-secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" target="traefik">
