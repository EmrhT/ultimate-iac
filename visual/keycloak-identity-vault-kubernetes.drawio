<mxfile host="Electron" agent="Codex">
  <diagram id="keycloak-identity-vault-kubernetes" name="Keycloak Identity and Authorization">
    <mxGraphModel dx="1510" dy="804" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="Keycloak Identity with Kubernetes and Vault Authorization" vertex="1">
          <mxGeometry height="40" width="790" x="505" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" value="One identity source · full-path group claims · independent authorization in Kubernetes and Vault · separate machine-secret and recovery paths" vertex="1">
          <mxGeometry height="25" width="895" x="453" y="60" as="geometry" />
        </mxCell>
        <mxCell id="identity-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontColor=#1E3A8A;fontSize=15;" value="Identity source and token shaping — Keycloak runtime state" vertex="1">
          <mxGeometry height="190" width="1740" x="30" y="105" as="geometry" />
        </mxCell>
        <mxCell id="k8s-client" parent="identity-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" value="&lt;b&gt;OIDC client: kubernetes&lt;/b&gt;&lt;br&gt;public client · enabled&lt;br&gt;redirect: http://localhost:8000&lt;br&gt;client-local groups mapper: full path → groups&lt;br&gt;audience mapper produces aud: kubernetes" vertex="1">
          <mxGeometry height="110" width="285" x="940" y="35" as="geometry" />
        </mxCell>
        <mxCell id="k8s-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;fontSize=15;" value="Human Kubernetes access — Keycloak authenticates; Kubernetes RBAC authorizes" vertex="1">
          <mxGeometry height="315" width="850" x="30" y="335" as="geometry" />
        </mxCell>
        <mxCell id="k8s-dev-rbac" parent="k8s-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" value="&lt;b&gt;Developers → namespace-scoped read access&lt;/b&gt;&lt;br&gt;RoleBindings in lab-a-dev and lab-b-dev → keycloak-dev-reader&lt;br&gt;get/list/watch Pods, ConfigMaps, Deployments, StatefulSets; get Pod logs&lt;br&gt;no production, exec, Secret read or workload mutation grant" vertex="1">
          <mxGeometry height="105" width="395" x="420" y="195" as="geometry" />
        </mxCell>
        <mxCell id="k8s-admin-rbac" parent="k8s-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;" value="&lt;b&gt;Admins → cluster-wide authorization&lt;/b&gt;&lt;br&gt;ClusterRoleBinding keycloak-platform-admins&lt;br&gt;keycloak:/platform/admins → cluster-admin" vertex="1">
          <mxGeometry height="85" width="365" x="25" y="205" as="geometry" />
        </mxCell>
        <mxCell id="api-authn" parent="k8s-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" value="&lt;b&gt;kube-apiserver JWT authentication&lt;/b&gt;&lt;br&gt;verify issuer + signature + expiry&lt;br&gt;require audience: kubernetes&lt;br&gt;username = keycloak: + preferred_username&lt;br&gt;groups = keycloak: + each groups value" vertex="1">
          <mxGeometry height="105" width="250" x="285" y="50" as="geometry" />
        </mxCell>
        <mxCell id="k8s-identity" parent="k8s-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" value="&lt;b&gt;Authenticated Kubernetes identity&lt;/b&gt;&lt;br&gt;user: keycloak:&amp;lt;preferred_username&amp;gt;&lt;br&gt;groups include:&lt;br&gt;keycloak:/platform/admins and/or&lt;br&gt;keycloak:/platform/devs" vertex="1">
          <mxGeometry height="85" width="225" x="590" y="60" as="geometry" />
        </mxCell>
        <mxCell id="e-api-identity" edge="1" parent="k8s-group" source="api-authn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;" target="k8s-identity">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="85" />
              <mxPoint x="550" y="85" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-identity-admin" edge="1" parent="k8s-group" source="k8s-identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;endArrow=block;endFill=1;fontSize=12;" target="k8s-admin-rbac">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="115" />
              <mxPoint x="560" y="175" />
              <mxPoint x="208" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-identity-dev" edge="1" parent="k8s-group" source="k8s-identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;fontSize=12;" target="k8s-dev-rbac">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="145" />
              <mxPoint x="700" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="vault-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#F5F3FF;strokeColor=#7C3AED;fontStyle=1;fontColor=#4C1D95;fontSize=15;" value="Human Vault access — Keycloak authenticates; Vault roles, groups and policies authorize" vertex="1">
          <mxGeometry height="315" width="850" x="920" y="335" as="geometry" />
        </mxCell>
        <mxCell id="vault-authz" parent="vault-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;strokeWidth=2;" value="&lt;b&gt;Vault authorization chain&lt;/b&gt;&lt;br&gt;OIDC role constraints/default policies&lt;br&gt;→ external identity-group aliases for Keycloak group names&lt;br&gt;→ Vault policies determine secret paths and capabilities&lt;br&gt;&lt;b&gt;exact role, alias and policy names are live Vault state—not in Git&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="535" y="37.5" as="geometry" />
        </mxCell>
        <mxCell id="vault-oidc" parent="vault-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" value="&lt;b&gt;Vault auth mount: oidc/&lt;/b&gt;&lt;br&gt;validates Keycloak issuer and client&lt;br&gt;selects a Vault OIDC role&lt;br&gt;reads user and groups claims&lt;br&gt;then issues a Vault token" vertex="1">
          <mxGeometry height="90" width="230" x="275" y="57.5" as="geometry" />
        </mxCell>
        <mxCell id="e-vault-oidc-authz" edge="1" parent="vault-group" source="vault-oidc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;endArrow=block;endFill=1;fontSize=12;" target="vault-authz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="secret-group" parent="1" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;fontColor=#7C2D12;fontSize=15;" value="&lt;div&gt;&lt;blockquote&gt;&lt;p&gt;&lt;strong&gt;Keycloak bootstrap secrets and recovery dependency — machine authentication, not human OIDC&lt;/strong&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="1740" x="30" y="670" as="geometry" />
        </mxCell>
        <mxCell id="recovery-order" parent="secret-group" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=9;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;" value="&lt;b&gt;Full-outage dependency and recovery order&lt;/b&gt;&lt;br&gt;1. Recover/unseal Vault through a non-Keycloak operator path.&lt;br&gt;2. Restore Vault data if required; let VSO materialize keycloak-credentials.&lt;br&gt;3. Recover Keycloak PostgreSQL, then Keycloak and the homelab realm.&lt;br&gt;4. Test OIDC only after issuer discovery is reachable.&lt;br&gt;&lt;b&gt;A Keycloak outage blocks both Kubernetes OIDC login and Vault OIDC login; existing tokens remain usable only until expiry.&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="505" x="1190" y="50" as="geometry" />
        </mxCell>
        <mxCell id="vault-kv" parent="secret-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=12;" value="&lt;b&gt;Vault KV&lt;/b&gt;&lt;br&gt;kv/infra/keycloak/credentials&lt;br&gt;Keycloak admin and PostgreSQL credentials" vertex="1">
          <mxGeometry height="90" width="250" x="25" y="70" as="geometry" />
        </mxCell>
        <mxCell id="vso-auth" parent="secret-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;" value="&lt;b&gt;Vault Secrets Operator&lt;/b&gt;&lt;br&gt;VaultAuth method: kubernetes&lt;br&gt;service account: keycloak/vault-auth&lt;br&gt;Vault role: vso-admin · audience: vault&lt;br&gt;refresh: 1 minute" vertex="1">
          <mxGeometry height="110" width="285" x="305" y="60" as="geometry" />
        </mxCell>
        <mxCell id="keycloak-secret" parent="secret-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" value="&lt;b&gt;Kubernetes Secret&lt;/b&gt;&lt;br&gt;keycloak/keycloak-credentials&lt;br&gt;created and overwritten by VSO&lt;br&gt;hmacSecretData enabled" vertex="1">
          <mxGeometry height="90" width="250" x="620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="keycloak-runtime" parent="secret-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" value="&lt;b&gt;Keycloak + PostgreSQL&lt;/b&gt;&lt;br&gt;consume the Secret at runtime&lt;br&gt;realm, groups, clients and mappers persist in Keycloak PostgreSQL" vertex="1">
          <mxGeometry height="90" width="250" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e-vault-vso" edge="1" parent="secret-group" source="vault-kv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" target="vso-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-vso-secret" edge="1" parent="secret-group" source="vso-auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" target="keycloak-secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-secret-keycloak" edge="1" parent="secret-group" source="keycloak-secret" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;endArrow=block;endFill=1;fontSize=12;" target="keycloak-runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="memory-group" parent="1" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontColor=#334155;fontSize=15;" value="Operational memory — ownership, effective access and first checks" vertex="1">
          <mxGeometry height="190" width="1740" x="30" y="885" as="geometry" />
        </mxCell>
        <mxCell id="human-users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;" value="&lt;b&gt;Human users&lt;/b&gt;&lt;br&gt;platform administrators&lt;br&gt;application developers&lt;br&gt;credentials and sessions originate in Keycloak" vertex="1">
          <mxGeometry height="110" width="225" x="55" y="155" as="geometry" />
        </mxCell>
        <mxCell id="realm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;strokeWidth=2;" value="&lt;b&gt;Keycloak realm: homelab&lt;/b&gt;&lt;br&gt;issuer: https://keycloak.no-name.win/realms/homelab&lt;br&gt;preferred_username identifies the user&lt;br&gt;master realm is not an application issuer" vertex="1">
          <mxGeometry height="130" width="285" x="310" y="145" as="geometry" />
        </mxCell>
        <mxCell id="groups" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=13;" value="&lt;b&gt;Group hierarchy&lt;/b&gt;&lt;br&gt;/platform&lt;br&gt;├─ /platform/admins&lt;br&gt;└─ /platform/devs&lt;br&gt;tokens carry full paths in claim: groups" vertex="1">
          <mxGeometry height="130" width="260" x="625" y="145" as="geometry" />
        </mxCell>
        <mxCell id="vault-client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=13;" value="&lt;b&gt;OIDC client: vault&lt;/b&gt;&lt;br&gt;confidential client · enabled&lt;br&gt;default client scope platform-groups emits full-path groups&lt;br&gt;callbacks: Vault UI and http://localhost:8250/oidc/callback" vertex="1">
          <mxGeometry height="105" width="405" x="1310" y="140" as="geometry" />
        </mxCell>
        <mxCell id="k8s-login" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=12;" value="&lt;b&gt;OIDC-capable kubeconfig/helper&lt;/b&gt;&lt;br&gt;opens browser login and receives localhost:8000 callback&lt;br&gt;client setup is operator-side runtime configuration" vertex="1">
          <mxGeometry height="105" width="230" x="55" y="385" as="geometry" />
        </mxCell>
        <mxCell id="vault-login" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=12;" value="&lt;b&gt;Vault UI or CLI login&lt;/b&gt;&lt;br&gt;UI callback under vault.no-name.win&lt;br&gt;CLI callback: localhost:8250&lt;br&gt;browser authenticates against Keycloak" vertex="1">
          <mxGeometry height="105" width="220" x="945" y="385" as="geometry" />
        </mxCell>
        <mxCell id="vault-semantics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=12;" value="&lt;b&gt;Authorization boundary&lt;/b&gt; — Keycloak proves identity and emits /platform/admins or /platform/devs. It does not grant Vault capabilities. Vault must map those claims to its own external groups and policies. The separate userpass/ auth mount is enabled as local Vault authentication; its intended operators and emergency use are runtime-managed and must be documented." vertex="1">
          <mxGeometry height="85" width="780" x="945" y="535" as="geometry" />
        </mxCell>
        <mxCell id="ownership" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" value="&lt;b&gt;Configuration ownership&lt;/b&gt;&lt;br&gt;&lt;b&gt;Git/Kubespray:&lt;/b&gt; API issuer/audience/claim prefixes, Kubernetes RBAC, Keycloak workload and VSO objects.&lt;br&gt;&lt;b&gt;Keycloak PostgreSQL runtime state:&lt;/b&gt; homelab realm, users/groups, clients, scopes and mappers.&lt;br&gt;&lt;b&gt;Vault runtime state:&lt;/b&gt; OIDC roles, identity-group aliases, policies and userpass identities. These cannot currently be reconstructed from this repository alone." vertex="1">
          <mxGeometry height="120" width="535" x="55" y="925" as="geometry" />
        </mxCell>
        <mxCell id="access-matrix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontSize=12;" value="&lt;b&gt;Effective access summary&lt;/b&gt;&lt;br&gt;&lt;b&gt;/platform/admins:&lt;/b&gt; Kubernetes cluster-admin; Vault access depends on live aliases/policies.&lt;br&gt;&lt;b&gt;/platform/devs:&lt;/b&gt; Kubernetes read-only in lab-a-dev and lab-b-dev; Vault access depends on live aliases/policies.&lt;br&gt;&lt;b&gt;Automation:&lt;/b&gt; Kubernetes service accounts and VSO Kubernetes auth are separate from human OIDC.&lt;br&gt;&lt;b&gt;Recovery:&lt;/b&gt; Kubespray admin kubeconfig and Vault unseal/non-OIDC credentials must remain separately controlled." vertex="1">
          <mxGeometry height="120" width="550" x="620" y="925" as="geometry" />
        </mxCell>
        <mxCell id="first-checks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;" value="&lt;b&gt;Source of truth and first checks&lt;/b&gt;&lt;br&gt;kubespray/.../k8s-cluster.yml · keycloak-rbac/base/{roles,bindings}.yaml · keycloak-config/base/vault-secrets.yaml&lt;br&gt;Inspect a token without sharing it: iss, aud, preferred_username, groups and exp. Then check API authentication versus kubectl auth can-i separately.&lt;br&gt;For Vault inspect auth/oidc roles, identity group aliases and resulting token policies while authenticated. Back up Keycloak state with operations/backups/homelab-backup.sh." vertex="1">
          <mxGeometry height="120" width="545" x="1200" y="925" as="geometry" />
        </mxCell>
        <mxCell id="e-users-realm" edge="1" parent="1" source="human-users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;fontSize=12;" target="realm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-realm-groups" edge="1" parent="1" source="realm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;fontSize=12;" target="groups">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-groups-k8sclient" edge="1" parent="1" source="groups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;" target="k8s-client">
          <mxGeometry relative="1" as="geometry">
