        <mxCell id="e-vault-login-oidc" edge="1" parent="1" source="vault-login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;endArrow=block;endFill=1;fontSize=12;" target="vault-oidc">
          <mxGeometry relative="1" as="geometry" />
