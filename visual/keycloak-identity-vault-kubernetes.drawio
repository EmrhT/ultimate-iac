          </mxGeometry>
        </mxCell>
        <mxCell id="e-groups-vaultclient" edge="1" parent="1" source="groups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;endArrow=block;endFill=1;fontSize=12;" target="vault-client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="180" />
              <mxPoint x="940" y="270" />
              <mxPoint x="1513" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-k8sclient-login" edge="1" parent="1" source="k8s-client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" target="k8s-login">
          <mxGeometry relative="1" as="geometry">
