        <mxCell id="e-k8s-login-api" edge="1" parent="1" source="k8s-login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;fontSize=12;" target="api-authn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-vaultclient-login" edge="1" parent="1" source="vault-client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;endArrow=block;endFill=1;fontSize=12;" target="vault-login">
          <mxGeometry relative="1" as="geometry">
