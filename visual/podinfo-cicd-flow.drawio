        <mxCell id="e-trivy-promote" edge="1" parent="1" source="trivy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;fontSize=12;" target="promote-dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
